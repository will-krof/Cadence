// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_TEST
  ON_HOLD
  DONE
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  createdAt    DateTime   @default(now())
  sessions     Session[]
  projects     Project[]
  developers   Developer[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Developer {
  id    String @id @default(cuid())
  name  String
  color String @default("#60a5fa")

  // Profile
  role           String?
  email          String?
  phone          String?
  avatar         String? // data URL, downscaled client-side before upload
  startDate      DateTime?
  salary         Int?
  currency       String    @default("USD")
  employmentType String? // FULL_TIME | PART_TIME | CONTRACT | INTERN
  active         Boolean   @default(true)
  notes          String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  tasks     Task[]
  memberships ProjectMember[]

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  hasTimeline Boolean  @default(true)
  hasTracker  Boolean  @default(true)
  hasTeam     Boolean  @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  tasks       Task[]
  sprints     Sprint[]
  roles       ProjectRole[]
  members     ProjectMember[]

  @@index([userId])
}

/// What a group of people is allowed to see on one project. Every project has
/// an admin role, which always sees everything and is the one that edits these.
model ProjectRole {
  id              String  @id @default(cuid())
  name            String
  isAdmin         Boolean @default(false)
  canViewTimeline Boolean @default(true)
  canViewTracker  Boolean @default(true)
  canViewTeam     Boolean @default(true)

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  members   MemberRole[]

  @@unique([projectId, name])
  @@index([projectId])
}

/// Someone's place on a project. Roles are per project, so the same person can
/// be an admin on one and a designer on another — and can hold more than one
/// role on the same project, which is why they hang off this rather than
/// sitting on it.
model ProjectMember {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  roles     MemberRole[]
  createdAt DateTime     @default(now())

  /// The invite link that lets this person into the project as themselves,
  /// seeing whatever their roles see. Made when they are put on the project;
  /// rotating it replaces the token, which is what makes the old link dead.
  /// Held as issued rather than hashed so the admin can copy it again later —
  /// it grants one project's roles, and rotating or revoking it is one click.
  inviteToken     String?   @unique
  inviteCreatedAt DateTime?
  /// Revoked links stay on the row: the admin can see there was one, and can
  /// hand out a new one without the old one ever working again.
  inviteRevoked   Boolean   @default(false)
  inviteUsedAt    DateTime?

  @@unique([projectId, developerId])
  @@index([developerId])
}

/// One role a member holds. Deleting the role or the membership takes the
/// pairing with it; the person and the project are untouched.
model MemberRole {
  memberId String
  member   ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  roleId String
  role   ProjectRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([roleId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  link        String?
  status      TaskStatus @default(TODO)
  startDate   DateTime
  endDate     DateTime
  order       Int        @default(0)
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  developerId String?
  developer   Developer? @relation(fields: [developerId], references: [id], onDelete: SetNull)
  // Deleting a sprint leaves its tasks behind rather than taking them with it.
  sprintId    String?
  sprint      Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // The board reads one project's tasks in `order`, so the index carries the
  // sort as well as the filter; the roster reads one person's tasks.
  @@index([projectId, order])
  // Carries "one person's tasks" and, as a covering index, the distinct
  // person/project pairs the team roster groups by.
  @@index([developerId, projectId])
  @@index([sprintId, order])
}

/// A project runs a series of these. Each one is its own board: a task belongs
/// to a sprint, so a sprint created ahead of time starts empty.
model Sprint {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int      @default(1)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@unique([projectId, number])
  @@index([projectId])
}
