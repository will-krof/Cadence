// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// What an account is, as against what a role on a project is. Everybody who
/// signs up is an admin: their workspace is theirs, and they hold every power
/// inside it. A superadmin holds nothing extra inside anybody's workspace — the
/// only thing the badge buys is a count of how the whole install is being used.
enum UserRole {
  ADMIN
  SUPERADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_TEST
  ON_HOLD
  DONE
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  /// Granted from the command line only. Nothing in the app can hand it out,
  /// so signing up can never be a way to ask for it.
  role         UserRole   @default(ADMIN)
  createdAt    DateTime   @default(now())
  sessions     Session[]
  projects     Project[]
  developers   Developer[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Developer {
  id    String @id @default(cuid())
  name  String
  color String @default("#60a5fa")

  // Profile
  role           String?
  email          String?
  phone          String?
  birthday       DateTime?
  /// Where they are this week: at work, off sick, on holiday, or simply away.
  /// Null reads as at work — most of a roster is, most of the time.
  workStatus     String? // WORKING | SICK | VACATION | AWAY
  startDate      DateTime?
  salary         Int?
  currency       String    @default("USD")
  employmentType String? // FULL_TIME | PART_TIME | CONTRACT | INTERN
  active         Boolean   @default(true)
  notes          String?

  /// The login they set up when they followed an invite link. Nothing until
  /// then: most of a roster never signs in, and a profile doesn't need one.
  /// One login per person, not per project — what they reach is decided by the
  /// projects they are a member of, and the roles they hold on each.
  username     String? @unique
  passwordHash String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  tasks     Task[]
  memberships ProjectMember[]
  sessions    DeveloperSession[]

  @@index([userId])
}

/// A signed-in team member. Kept apart from `Session` because the two answer
/// different questions: that one is an account holding a workspace, this one is
/// a person holding roles on some of its projects.
model DeveloperSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([developerId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  hasTimeline Boolean  @default(true)
  hasTracker  Boolean  @default(true)
  /// The team roster is not a tool a project switches off — every project has
  /// people — so there is no `hasTeam` here. Who may open it is the role's.
  hasWiki     Boolean  @default(true)
  /// Put away: still openable and still holding its work, but out of the run of
  /// projects being worked on.
  archived    Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  tasks       Task[]
  sprints     Sprint[]
  roles       ProjectRole[]
  members     ProjectMember[]
  wikiPages   WikiPage[]

  @@index([userId])
}

/// What a group of people is allowed to see on one project. Every project has
/// an admin role, which always sees everything and is the one that edits these.
model ProjectRole {
  id              String  @id @default(cuid())
  name            String
  isAdmin         Boolean @default(false)
  /// What a role may do with each tool: nothing, watch it, or work in it.
  /// Editing implies watching — a role that can change a board can see it —
  /// and the pair is stored rather than one field, so "can see it" survives
  /// having the right to change it taken away.
  canViewTimeline Boolean @default(true)
  canEditTimeline Boolean @default(false)
  canViewTracker  Boolean @default(true)
  canEditTracker  Boolean @default(false)
  canViewTeam     Boolean @default(true)
  canEditTeam     Boolean @default(false)
  canViewWiki     Boolean @default(true)
  canEditWiki     Boolean @default(false)

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  members   MemberRole[]

  @@unique([projectId, name])
  @@index([projectId])
}

/// Someone's place on a project. Roles are per project, so the same person can
/// be an admin on one and a designer on another — and can hold more than one
/// role on the same project, which is why they hang off this rather than
/// sitting on it.
model ProjectMember {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  roles     MemberRole[]
  createdAt DateTime     @default(now())

  /// The invite link that lets this person set up their login for the project.
  /// Made when they are put on the project; rotating it replaces the token,
  /// which is what makes the old link dead. Held as issued rather than hashed
  /// so the admin can copy it again later — on its own it grants nothing but
  /// the chance to pick a username and a password.
  inviteToken     String?   @unique
  inviteCreatedAt DateTime?
  /// A link is good for three days. Past that it stops working and a fresh one
  /// takes its place, so an unopened invite is never a link that lives forever.
  inviteExpiresAt DateTime?
  /// Revoked links stay on the row: the admin can see there was one, and can
  /// hand out a new one without the old one ever working again.
  inviteRevoked   Boolean   @default(false)
  inviteUsedAt    DateTime?

  @@unique([projectId, developerId])
  @@index([developerId])
}

/// One role a member holds. Deleting the role or the membership takes the
/// pairing with it; the person and the project are untouched.
model MemberRole {
  memberId String
  member   ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  roleId String
  role   ProjectRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([roleId])
}

/// A page of the project's wiki: whatever a team needs written down that isn't
/// a task. Plain text, kept in the row — there are no attachments and no
/// uploads anywhere in this app.
model WikiPage {
  id      String @id @default(cuid())
  title   String
  content String @default("")
  /// Hand-ordered among its siblings, so a wiki reads in the order somebody
  /// arranged it rather than the order pages happened to be written.
  order   Int    @default(0)

  /// A section, a section of a section, as deep as a project needs. Null is a
  /// page at the top of the wiki. Deleting a section takes what is under it.
  parentId String?
  parent   WikiPage?  @relation("WikiTree", fields: [parentId], references: [id], onDelete: Cascade)
  children WikiPage[] @relation("WikiTree")

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, parentId, order])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  link        String?
  status      TaskStatus @default(TODO)
  startDate   DateTime
  endDate     DateTime
  order       Int        @default(0)
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  developerId String?
  developer   Developer? @relation(fields: [developerId], references: [id], onDelete: SetNull)
  /// The task this one is a step of, if it is one. Subtasks go one level deep:
  /// a step of a step is a task in its own right, and the board says so.
  /// Deleting a task takes its subtasks — they are parts of it, not work that
  /// outlives it.
  parentId    String?
  parent      Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]     @relation("Subtasks")
  /// What happened to it, in order: every status it was moved to, and when.
  events      TaskEvent[]
  // Deleting a sprint leaves its tasks behind rather than taking them with it.
  sprintId    String?
  sprint      Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // The board reads one project's tasks in `order`, so the index carries the
  // sort as well as the filter; the roster reads one person's tasks.
  @@index([projectId, order])
  // Carries "one person's tasks" and, as a covering index, the distinct
  // person/project pairs the team roster groups by.
  @@index([developerId, projectId])
  @@index([sprintId, order])
  // The parts of one task, read together with it.
  @@index([parentId])
}

/// A project runs a series of these. Each one is its own board: a task belongs
/// to a sprint, so a sprint created ahead of time starts empty.
/// One thing that happened to a task: it was moved to a status, on a day, by
/// somebody. The row is the record — a task's own history, kept as it was
/// written rather than worked out afterwards from the state it ended in.
model TaskEvent {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  status TaskStatus
  /// What it was before, so a line reads as a move rather than a state. Null on
  /// the first event, which is the task being written.
  from   TaskStatus?
  /// Who moved it, as they were called at the time. A name rather than a link:
  /// this is a record of what happened, and it shouldn't change when a profile
  /// is renamed or deleted.
  by     String?
  at     DateTime   @default(now())

  @@index([taskId, at])
}

model Sprint {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int      @default(1)
  startDate DateTime
  endDate   DateTime
  /// A sprint that has been put away. Its tasks stay where they are and it can
  /// still be opened on a board; it just stops being one of the sprints the
  /// project is working through, and stops being the one a board lands on.
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@unique([projectId, number])
  @@index([projectId])
}
