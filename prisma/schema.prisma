// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_TEST
  ON_HOLD
  DONE
}

model Developer {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#60a5fa")
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  hasTimeline Boolean  @default(true)
  hasTracker  Boolean  @default(true)
  createdAt   DateTime @default(now())
  tasks       Task[]
  sprint      Sprint?
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  link        String?
  status      TaskStatus @default(TODO)
  startDate   DateTime
  endDate     DateTime
  order       Int        @default(0)
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  developerId String?
  developer   Developer? @relation(fields: [developerId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId])
}

model Sprint {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  updatedAt DateTime @updatedAt
}
