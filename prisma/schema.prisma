// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// What an account is, as against what a role on a project is. Everybody who
/// signs up is an admin: their workspace is theirs, and they hold every power
/// inside it. A superadmin holds nothing extra inside anybody's workspace — the
/// only thing the badge buys is a count of how the whole install is being used.
enum UserRole {
  ADMIN
  SUPERADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_TEST
  ON_HOLD
  DONE
}

/// How much a task wants doing before the others. Kept apart from status: one
/// says where the work is, this says which of two waiting tasks is picked up
/// first. Everything written without an answer is ordinary work.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  /// Granted from the command line only. Nothing in the app can hand it out,
  /// so signing up can never be a way to ask for it.
  role         UserRole   @default(ADMIN)
  createdAt    DateTime   @default(now())
  sessions     Session[]
  projects     Project[]
  developers   Developer[]
  notes        Note[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Developer {
  id    String @id @default(cuid())
  name  String
  color String @default("#60a5fa")

  // Profile
  role           String?
  email          String?
  phone          String?
  birthday       DateTime?
  /// Where they are this week: at work, off sick, on holiday, or simply away.
  /// Null reads as at work — most of a roster is, most of the time.
  workStatus     String? // WORKING | SICK | VACATION | AWAY
  startDate      DateTime?
  salary         Int?
  currency       String    @default("USD")
  employmentType String? // FULL_TIME | PART_TIME | CONTRACT | INTERN
  active         Boolean   @default(true)
  notes          String?

  /// Where they are in the world, and how they work there. A team spread over
  /// three continents plans around these more often than around anything else
  /// on a card, so they are the working half of a profile rather than the
  /// owner's: colleagues see them.
  ///
  /// The zone is an IANA name — `Europe/Kyiv` — kept rather than an offset,
  /// because an offset is only right until the clocks change. What the card
  /// shows is the time read off it, worked out fresh every minute.
  timezone       String?
  /// Said in words rather than as a code: the roster is read by people, and
  /// nothing here sorts or groups by country.
  country        String?
  /// The languages they speak, comma separated. A list somebody types, not one
  /// this app decided on — a team knows its own languages, and half of them
  /// aren't on anybody's dropdown.
  languages      String?
  /// REMOTE | OFFICE | HYBRID. Null is nobody having said.
  workLocation   String?

  /// The login they set up when they followed an invite link. Nothing until
  /// then: most of a roster never signs in, and a profile doesn't need one.
  /// One login per person, not per project — what they reach is decided by the
  /// projects they are a member of, and the roles they hold on each.
  username     String? @unique
  passwordHash String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  /// The work they are on. A task can be shared, so this is the join rather
  /// than a column on the task.
  tasks     TaskAssignee[]
  memberships ProjectMember[]
  sessions    DeveloperSession[]
  /// Their own notes — not the `notes` field above, which is what the roster
  /// says about them. These are theirs, and nobody else reads them.
  ownNotes    Note[]

  @@index([userId])
}

/// Somebody's own notes. Nobody else's business — not the account that owns
/// the workspace, not the people on the same projects — so a note belongs to
/// whoever is signed in rather than to a project, and every read is scoped to
/// them. Notes are not a wiki: there is no tree and nothing is shared, just a
/// flat pile of pages in the order their writer put them.
model Note {
  id      String @id @default(cuid())
  /// The first line of the writing, kept as a column so a list of notes
  /// doesn't have to carry the notes.
  title   String @default("")
  content String @default("")

  /// Where it sits in the pile. Notes were listed newest-touched-first, which
  /// is a sensible order nobody chose: opening a note to read it moved it, and
  /// the one you always want at the top drifted down. So the pile is ordered by
  /// hand — drag a note where it belongs — and a new one lands at the top.
  order   Int    @default(0)
  /// Held at the top of the pile, above everything unpinned, whatever the
  /// dragging says. Kept apart from `order` rather than folded into it: a note
  /// unpinned goes back where it was in the pile, not to the end of it.
  pinned  Boolean @default(false)

  /// Exactly one of these: a workspace's owner, or one of its people.
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  developerId String?
  developer   Developer? @relation(fields: [developerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Read in the order they were arranged, one owner at a time, pinned first.
  @@index([userId, pinned, order])
  @@index([developerId, pinned, order])
}

/// A signed-in team member. Kept apart from `Session` because the two answer
/// different questions: that one is an account holding a workspace, this one is
/// a person holding roles on some of its projects.
model DeveloperSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([developerId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Every tool starts off. A new project is a name and a description, and
  /// what it is made of is the first thing its owner is asked — which is a
  /// shorter question than working out what to take away from a project that
  /// arrived with everything.
  hasTimeline Boolean  @default(false)
  hasTracker  Boolean  @default(false)
  /// The team roster is not a tool a project switches off — every project has
  /// people — so there is no `hasTeam` here. Who may open it is the role's.
  hasWiki     Boolean  @default(false)
  /// Whether the work is planned in sprints at all. Off, the boards show the
  /// project's whole plan at once and nothing asks which sprint to put a task
  /// in. Sprints already planned are kept, not deleted — turning the tool back
  /// on finds them where they were.
  hasSprints  Boolean  @default(false)
  /// Whether this project is run through roles. Off, the roles it has stop
  /// being offered or asked about — for a project one person runs, a table of
  /// permissions is a screen of questions nobody has.
  hasRoles    Boolean  @default(false)

  /// When the project runs, said rather than worked out. A project that plans
  /// in sprints gets its span from them and leaves these null; one that doesn't
  /// still has a beginning and an end, and this is where it says so.
  startDate   DateTime?
  endDate     DateTime?

  /// Which of a task's fields this project's forms offer. A team that never
  /// writes a link, or never argues about priority, shouldn't have to look at
  /// the field that asks — so each one can be put away, and what is already
  /// written stays in the row either way.
  taskHasPriority Boolean @default(false)
  taskHasLink     Boolean @default(false)
  taskHasDates    Boolean @default(false)
  taskHasHistory  Boolean @default(false)
  taskHasComments Boolean @default(false)
  /// Whether a task is broken into steps, and whether it waits on other tasks.
  /// Both are halves of a task like the rest: a team that plans in one-line
  /// jobs, or one whose order is obvious, shouldn't be asked about either.
  taskHasSubtasks     Boolean @default(false)
  taskHasDependencies Boolean @default(false)
  /// Whether tasks carry tags at all. The tags themselves are the project's
  /// own — every team labels its work in its own words — so they are rows
  /// rather than a list this app decided on.
  taskHasTags         Boolean @default(false)
  /// Whether a task says how long it is expected to take. A guess at the size
  /// of a job is a thing some teams live by and others never write down, so it
  /// is a field like the rest: off until a project asks for it.
  taskHasEstimate     Boolean @default(false)
  /// Put away: still openable and still holding its work, but out of the run of
  /// projects being worked on.
  archived    Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  tasks       Task[]
  sprints     Sprint[]
  roles       ProjectRole[]
  members     ProjectMember[]
  wikiPages   WikiPage[]
  tags        ProjectTag[]

  @@index([userId])
}

/// A label a project puts on its work, in its own words and its own colour.
/// Switching tags off keeps them: what a project calls its work outlives a
/// decision to stop showing it.
model ProjectTag {
  id        String   @id @default(cuid())
  name      String
  /// A hex colour, checked before it is stored — it ends up in a style.
  color     String   @default("#2a78d6")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  tasks     TaskTag[]

  /// Two tags with one name is two of the same tag.
  @@unique([projectId, name])
  @@index([projectId])
}

/// One tag on one task.
model TaskTag {
  taskId String
  task   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String
  tag    ProjectTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

/// What a group of people is allowed to see on one project. Every project has
/// an admin role, which always sees everything and is the one that edits these.
model ProjectRole {
  id              String  @id @default(cuid())
  name            String
  isAdmin         Boolean @default(false)
  /// What a role may do with each tool: nothing, watch it, or work in it.
  /// Editing implies watching — a role that can change a board can see it —
  /// and the pair is stored rather than one field, so "can see it" survives
  /// having the right to change it taken away.
  canViewTimeline Boolean @default(true)
  canEditTimeline Boolean @default(false)
  canViewTracker  Boolean @default(true)
  canEditTracker  Boolean @default(false)
  canViewTeam     Boolean @default(true)
  canEditTeam     Boolean @default(false)
  canViewWiki     Boolean @default(true)
  canEditWiki     Boolean @default(false)

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  members   MemberRole[]

  @@unique([projectId, name])
  @@index([projectId])
}

/// Someone's place on a project. Roles are per project, so the same person can
/// be an admin on one and a designer on another — and can hold more than one
/// role on the same project, which is why they hang off this rather than
/// sitting on it.
model ProjectMember {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  roles     MemberRole[]
  createdAt DateTime     @default(now())

  /// The invite link that lets this person set up their login for the project.
  /// Made when they are put on the project; rotating it replaces the token,
  /// which is what makes the old link dead. Held as issued rather than hashed
  /// so the admin can copy it again later — on its own it grants nothing but
  /// the chance to pick a username and a password.
  inviteToken     String?   @unique
  inviteCreatedAt DateTime?
  /// A link is good for three days. Past that it stops working and a fresh one
  /// takes its place, so an unopened invite is never a link that lives forever.
  inviteExpiresAt DateTime?
  /// Revoked links stay on the row: the admin can see there was one, and can
  /// hand out a new one without the old one ever working again.
  inviteRevoked   Boolean   @default(false)
  inviteUsedAt    DateTime?

  @@unique([projectId, developerId])
  @@index([developerId])
}

/// One role a member holds. Deleting the role or the membership takes the
/// pairing with it; the person and the project are untouched.
model MemberRole {
  memberId String
  member   ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  roleId String
  role   ProjectRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([roleId])
}

/// A page of the project's wiki: whatever a team needs written down that isn't
/// a task. Plain text, kept in the row — there are no attachments and no
/// uploads anywhere in this app.
model WikiPage {
  id      String @id @default(cuid())
  title   String
  content String @default("")
  /// Hand-ordered among its siblings, so a wiki reads in the order somebody
  /// arranged it rather than the order pages happened to be written.
  order   Int    @default(0)

  /// A section, a section of a section, as deep as a project needs. Null is a
  /// page at the top of the wiki. Deleting a section takes what is under it.
  parentId String?
  parent   WikiPage?  @relation("WikiTree", fields: [parentId], references: [id], onDelete: Cascade)
  children WikiPage[] @relation("WikiTree")

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, parentId, order])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  link        String?
  status      TaskStatus @default(TODO)
  /// What it is worth doing first. Ordinary work until somebody says otherwise.
  priority    TaskPriority @default(MEDIUM)
  /// When the task runs, if anybody has said. A project that doesn't ask about
  /// dates writes tasks without them, and so does one that does ask and was
  /// left blank — work that hasn't been placed in time yet is a real state, and
  /// today-to-today was this app inventing an answer nobody gave. The timeline
  /// draws a bar for a task that has both and leaves the rest to the list.
  startDate   DateTime?
  endDate     DateTime?
  /// How long the work is expected to take, in minutes. One canonical unit
  /// rather than a number and a unit that have to be read together: hours and
  /// days are two ways of saying the same quantity, and storing the quantity
  /// means nothing has to convert to compare two tasks or add a column up.
  ///
  /// Minutes rather than hours because half a day and a quarter of an hour are
  /// both things people write, and integers avoid the rounding a float would
  /// bring to something as ordinary as "1.5h".
  estimateMinutes Int?
  /// Which unit it was written in — HOURS or DAYS — so the form says it back
  /// the way it was typed. This is a display note and nothing more: the
  /// quantity above is the answer, and a task written as 2 days reads as 16
  /// hours the moment somebody switches the picker.
  estimateUnit    String?
  order       Int        @default(0)
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Who is on it — up to four people, in the order they were put on. A short
  /// list rather than one name: work of any size is done by more than one
  /// person, and a board that can only say one of them says the wrong thing.
  assignees   TaskAssignee[]
  /// What this project calls it. A tag belongs to the project, so a task can
  /// only wear the labels its own project has.
  tags        TaskTag[]
  /// The task this one is a step of, if it is one. Subtasks go one level deep:
  /// a step of a step is a task in its own right, and the board says so.
  /// Deleting a task takes its subtasks — they are parts of it, not work that
  /// outlives it.
  parentId    String?
  parent      Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]     @relation("Subtasks")
  /// What happened to it, in order: every status it was moved to, and when.
  events      TaskEvent[]
  /// What people said about it, in order. Anybody who can open the board can
  /// write one — talking about work is not changing it.
  comments    TaskComment[]
  /// The work this task is waiting on, and the work waiting on it. Two sides of
  /// the same row — a dependency is one fact, read from either end.
  blockedBy   TaskDependency[] @relation("Blocked")
  blocks      TaskDependency[] @relation("Blocker")
  // Deleting a sprint leaves its tasks behind rather than taking them with it.
  sprintId    String?
  sprint      Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // The board reads one project's tasks in `order`, so the index carries the
  // sort as well as the filter; the roster reads one person's tasks.
  @@index([projectId, order])
  @@index([sprintId, order])
  // The parts of one task, read together with it.
  @@index([parentId])
}

/// One person on one task. The row is the whole fact — there is no lead
/// assignee and no deputy — and `order` only keeps the avatars from shuffling
/// between renders.
model TaskAssignee {
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  order       Int       @default(0)

  @@id([taskId, developerId])
  // Carries "one person's tasks" and, as a covering index, the distinct
  // person/project pairs the team roster groups by.
  @@index([developerId, taskId])
}

/// A project runs a series of these. Each one is its own board: a task belongs
/// to a sprint, so a sprint created ahead of time starts empty.
/// One thing that happened to a task: it was moved to a status, on a day, by
/// somebody. The row is the record — a task's own history, kept as it was
/// written rather than worked out afterwards from the state it ended in.
model TaskEvent {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  status TaskStatus
  /// What it was before, so a line reads as a move rather than a state. Null on
  /// the first event, which is the task being written.
  from   TaskStatus?
  /// Who moved it, as they were called at the time. A name rather than a link:
  /// this is a record of what happened, and it shouldn't change when a profile
  /// is renamed or deleted.
  by     String?
  at     DateTime   @default(now())

  @@index([taskId, at])
}

/// Something somebody said about a task. Sits beside its history rather than in
/// it: the history is what happened to the work, this is what people made of it.
///
/// Writing one asks only that the person can open the board — a role given a
/// board to watch can still say what it sees. Changing the work is a separate
/// question, and the edit flags keep answering it on their own.
model TaskComment {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  body String
  /// Who wrote it, as they were called at the time — the same bargain the
  /// history makes. A renamed profile doesn't rewrite what was said.
  by   String

  /// Which team member wrote it, when one did. Null means the workspace's owner
  /// wrote it. Kept alongside the name so a person can take their own comment
  /// back without being able to touch anybody else's; the name stays whatever
  /// happens to the profile.
  byDeveloperId String?

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

/// One task waiting on another: the blocker has to finish before the blocked
/// one can start. Both ends are tasks of the same project — the routes check
/// that, because a plan that reaches across projects is a plan nobody's board
/// can draw. Deleting either task takes the link with it: a dependency on work
/// that no longer exists is not a dependency.
model TaskDependency {
  id String @id @default(cuid())

  /// The one that has to finish.
  blockerId String
  blocker   Task   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  /// The one that is waiting.
  blockedId String
  blocked   Task   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Said twice is said once: a pair is a link or it isn't.
  @@unique([blockerId, blockedId])
  /// Read from either end — "what is this waiting on" and "what waits on this".
  @@index([blockedId])
  @@index([blockerId])
}

model Sprint {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int      @default(1)
  startDate DateTime
  endDate   DateTime
  /// A sprint that has been put away. Its tasks stay where they are and it can
  /// still be opened on a board; it just stops being one of the sprints the
  /// project is working through, and stops being the one a board lands on.
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@unique([projectId, number])
  @@index([projectId])
}
